{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunopetrovic/SOUL.md-Blueprint/blob/main/spec/SOUL-PACKAGE.schema.json",
  "title": "SOUL Blueprint Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "package", "identity", "tests"],
  "properties": {
    "spec_version": {"const": "1.0.0"},
    "package": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "description": {"type": "string"}, "license": {"type": ["string", "null"]}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["canonical"], "properties": {"canonical": {"type": "string"}, "ir": {"type": ["string", "null"]}, "identity_metadata": {"type": ["string", "null"]}, "style": {"type": ["string", "null"]}}},
    "operations": {"type": ["string", "null"]},
    "user_context": {"type": ["string", "null"]},
    "memory": {"type": ["string", "null"]},
    "skills": {"type": "array", "items": {"type": "string"}},
    "examples": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "runtime_profiles": {"type": "array", "items": {"type": "string"}},
    "adapters": {"type": "object", "additionalProperties": {"type": "string"}},
    "provenance_registry": {"type": ["string", "null"]},
    "tested_matrix": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
  }
}
