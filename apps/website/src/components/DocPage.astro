---
import Base from '../layouts/Base.astro';
import { readRepo, renderMarkdown, sourceUrl } from '../lib/content';
interface Props { title: string; description: string; source: string; eyebrow?: string; }
const { title, description, source, eyebrow = 'Canonical document' } = Astro.props;
const raw = readRepo(source);
const { html, headings } = renderMarkdown(raw);
const toc = headings.filter(h => h.level >= 2 && h.level <= 3);
---
<Base title={`${title} · SOUL.md Blueprint`} description={description}>
  <section class="doc-hero shell compact-hero">
    <div><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="hero-copy">{description}</p><div class="hero-buttons"><a class="button primary" href={sourceUrl(source)} target="_blank" rel="noreferrer">View source ↗</a><a class="button" href={`${Astro.url.pathname}.md`}>Markdown mirror ↓</a></div></div>
    <div class="doc-signal-panel"><span class="panel-label">Source</span><code>{source}</code><span class="status"><i class="status-dot"></i> PRERENDERED</span></div>
  </section>
  <section class="doc-stage shell">
    {toc.length > 0 && <details class="mobile-toc"><summary>On this page</summary><nav>{toc.map(h => <a href={`#${h.id}`}>{h.text}</a>)}</nav></details>}
    <article class="prose" set:html={html} />
    {toc.length > 0 && <aside class="toc" aria-label="On this page"><span class="panel-label">On this page</span>{toc.map(h => <a class={`toc-l${h.level}`} href={`#${h.id}`}>{h.text}</a>)}</aside>}
  </section>
</Base>
