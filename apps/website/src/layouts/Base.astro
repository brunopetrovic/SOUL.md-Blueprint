---
import '../styles.css';
import { repoVersion, REPO_URL } from '../lib/content';
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  markdownPath?: string | null;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, canonicalPath = Astro.url.pathname, markdownPath = `${Astro.url.pathname === '/' ? '/index' : Astro.url.pathname}.md`, jsonLd } = Astro.props;
const site = Astro.site || new URL('https://soul-md-blueprint.pages.dev');
const canonical = new URL(canonicalPath, site).toString();
const mdAlt = markdownPath ? new URL(markdownPath, site).toString() : null;
const version = repoVersion();
const schema = jsonLd || {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: 'SOUL.md Blueprint', url: site.toString() }
};
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#090b0d" />
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="describedby" href="/llms.txt" />
  <link rel="agent-permissions" href="/.well-known/agent-permissions.json" type="application/json" />
  <link rel="service-desc" href="/openapi.json" type="application/openapi+json;version=3.1" />
  <link rel="api-catalog" href="/.well-known/api-catalog" type="application/linkset+json" />
  <link rel="agent-skills" href="/.well-known/agent-skills/index.json" type="application/json" />
  {mdAlt && <link rel="alternate" type="text/markdown" href={mdAlt} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <canvas id="network-canvas" aria-hidden="true"></canvas>
  <div class="grain" aria-hidden="true"></div>
  <div class="orb one" aria-hidden="true"></div>
  <div class="orb two" aria-hidden="true"></div>

  <div class="shell site-shell">
    <nav class="site-nav" aria-label="Primary navigation">
      <a href="/" class="brand" aria-label="SOUL.md Blueprint home"><span class="brand-mark" aria-hidden="true"></span>SOUL.MD</a>
      <div class="nav-links">
        <a href="/blueprint">Blueprint</a><a href="/runtimes">Runtimes</a><a href="/evaluation">Evals</a><a href="/case-studies">Cases</a>
      </div>
      <div class="nav-actions">
        <span class="version-pill">v{version}</span>
        <button class="icon-button" id="search-toggle" aria-label="Search" aria-haspopup="dialog">⌘K</button>
        <button class="icon-button" id="theme-toggle" aria-label="Toggle theme">◐</button>
        <a class="button nav-github" href={REPO_URL} target="_blank" rel="noreferrer">GitHub ↗</a>
        <button class="icon-button menu-button" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">☰</button>
      </div>
    </nav>
  </div>

  <main id="main"><slot /></main>

  <footer class="shell site-footer">
    <span>SOUL.md Blueprint · runtime-neutral agent identity engineering</span>
    <div class="footer-links"><a href="/glossary">Glossary</a><a href="/sitemap.md">Sitemap</a><a href="/AGENTS.md">AGENTS.md</a><a href="/llms.txt">llms.txt</a><a href="/.well-known/agent-skills/index.json">Skills</a><a href="/openapi.json">OpenAPI</a><a href={REPO_URL}>GitHub</a></div>
  </footer>

  <aside class="drawer" id="mobile-drawer" aria-hidden="true" inert>
    <div class="drawer-panel" role="dialog" aria-modal="true" aria-label="Navigation">
      <div class="drawer-top"><span class="brand"><span class="brand-mark"></span>SOUL.MD</span><button class="icon-button" id="menu-close" aria-label="Close menu">×</button></div>
      <div class="drawer-links">
        <a href="/blueprint">Blueprint</a><a href="/architecture">Architecture</a><a href="/engineering">Engineering</a><a href="/runtimes">Runtimes</a><a href="/evaluation">Evaluation</a><a href="/spec">Specification</a><a href="/tooling">Tooling</a><a href="/case-studies">Case studies</a><a href="/research">Research</a><a href="/sources">Sources</a><a href="/glossary">Glossary</a><a href="/governance">Governance</a><a href="/repository">Repository</a>
      </div>
    </div>
  </aside>

  <div class="modal-backdrop" id="search-modal" aria-hidden="true" inert>
    <div class="modal search-modal" role="dialog" aria-modal="true" aria-labelledby="search-title">
      <div class="search-head"><div><p class="eyebrow">Knowledge graph search</p><h2 id="search-title">Search the Blueprint</h2></div><button class="icon-button" id="search-close" aria-label="Close search">×</button></div>
      <label class="sr-only" for="search-input">Search</label>
      <input id="search-input" type="search" placeholder="Search doctrine, runtimes, case studies…" autocomplete="off" />
      <div id="search-results" class="search-results" role="listbox" aria-label="Search results"></div>
    </div>
  </div>

  <script src="/site.js" defer></script>
</body>
</html>
