---
import Base from '../../layouts/Base.astro';
import { caseStudySlugs,titleize,loadCase,renderMarkdown,sourceUrl } from '../../lib/content';
export function getStaticPaths(){return caseStudySlugs.map(slug=>({params:{slug}}));}
const {slug}=Astro.params; const c=loadCase(slug!); const soul=renderMarkdown(c.soul); const agents=renderMarkdown(c.agents);
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':'Case Studies','item':new URL('/case-studies',Astro.site).toString()},{'@type':'ListItem','position':2,'name':titleize(slug!),'item':Astro.url.toString()}]};
---
<Base title={`${titleize(slug!)} Case Study · SOUL.md Blueprint`} description={`Paired SOUL.md and AGENTS.md reference architecture for ${titleize(slug!)}.`} jsonLd={breadcrumb}>
<section class="doc-hero shell compact-hero"><div><p class="eyebrow">Applied case study</p><h1>{titleize(slug!)}</h1><p class="hero-copy">Study how durable identity and judgment are separated from mutable workspace operations.</p></div></section>
<section class="shell" style="padding-bottom:120px" data-tabs>
  <div class="tab-list" role="tablist" aria-label="Case-study layers"><button class="button primary" role="tab" aria-controls="panel-soul">SOUL.md</button><button class="button" role="tab" aria-controls="panel-agents">AGENTS.md</button></div>
  <section id="panel-soul" class="tab-panel" role="tabpanel"><p><a class="button" href={sourceUrl(c.soulRel)}>View SOUL source ↗</a></p><article class="prose" set:html={soul.html}/></section>
  <section id="panel-agents" class="tab-panel" role="tabpanel"><p><a class="button" href={sourceUrl(c.agentsRel)}>View AGENTS source ↗</a></p><article class="prose" set:html={agents.html}/></section>
</section>
</Base>
